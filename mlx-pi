class FriendlyParser(argparse.ArgumentParser):
    """Argparse parser that renders usage errors in mlx-pi's style: a red error
    line, a 'did you mean …' for unknown subcommands, and a pointer to help —
    instead of argparse's terse stderr dump. Subparsers inherit this class, so
    bad flags on a subcommand also get a friendly message."""

    def error(self, message: str):
        m = re.search(r"invalid choice: '([^']*)'", message)
        names = []
        for action in self._actions:
            if isinstance(action, argparse._SubParsersAction):
                names = list(action.choices)
        if m and names:  # unknown top-level subcommand
            err(f"unknown command '{m.group(1)}'")
            guess = difflib.get_close_matches(m.group(1), names, n=1)
            if guess:
                console.print(f"  [dim]Did you mean[/] [cyan]mlx-pi {guess[0]}[/][dim]?[/]")
            console.print(f"  [dim]Available:[/] {', '.join(f'[cyan]{n}[/]' for n in names)}")
            console.print("  [dim]Run [cyan]mlx-pi[/] for an overview, or "
                          "[cyan]mlx-pi <command> --help[/] for flags.[/]")
        else:  # bad flags / args on a (sub)command
            err(message)
            console.print(f"  [dim]Try [cyan]{self.prog} --help[/].[/]")
        sys.exit(2)


def build_parser() -> argparse.ArgumentParser:
    p = FriendlyParser(
        prog="mlx-pi",
        description="Run local LLMs on Apple Silicon with MLX + the pi agent.",
    )
    sub = p.add_subparsers(dest="cmd")

    def server_opts(sp):
        sp.add_argument("--host", default=DEFAULT_HOST, help=f"bind address (default {DEFAULT_HOST})")
        sp.add_argument("--port", type=_port, default=DEFAULT_PORT, help=f"port (default {DEFAULT_PORT})")
        sp.add_argument("--allow-network", action="store_true",
                        help="allow a non-loopback bind (the API is unauthenticated)")
        sp.add_argument("-y", "--yes", action="store_true", help="skip the download-size prompt")

    sp = sub.add_parser("setup", help="install mlx-lm + mlx-vlm + pi and configure everything")
    add_model_flags(sp); server_opts(sp)
    sp.add_argument("-p", "--prefetch", action="store_true", help="download the model now (with size check)")
    sp.add_argument("--no-link", action="store_true", help="don't symlink mlx-pi onto your PATH")
    sp.add_argument("--pin", action="store_true",
                    help="register ONLY this model with pi (no hot-swap drift)")
    sp.set_defaults(func=cmd_setup)

    sp = sub.add_parser("up", help="start the MLX server in the background")
    add_model_flags(sp); server_opts(sp); sp.set_defaults(func=cmd_up)

    sp = sub.add_parser("down", help="stop the background server")
    server_opts(sp); sp.set_defaults(func=cmd_down)

    sp = sub.add_parser("restart", help="restart the background server")
    add_model_flags(sp); server_opts(sp); sp.set_defaults(func=cmd_restart)

    sp = sub.add_parser("use", help="switch the served model AND pi's default together")
    sp.add_argument("repo", nargs="?", metavar="REPO_ID",
                    help="model id to switch to (or use a preset flag below)")
    add_model_flags(sp); server_opts(sp)
    sp.add_argument("--pin", action="store_true",
                    help="register ONLY this model with pi (no hot-swap drift)")
    sp.set_defaults(func=cmd_use)

    sp = sub.add_parser("status", help="show running state + health")
    server_opts(sp); sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("logs", help="tail the server log")
    sp.set_defaults(func=cmd_logs)

    mp = sub.add_parser("models", help="list / download / remove models")
    mp.set_defaults(func=cmd_models)  # bare `models` = list
    msub = mp.add_subparsers(dest="models_cmd")
    lp = msub.add_parser("list", help="list preset + downloaded models")
    lp.set_defaults(func=cmd_models)
    pp = msub.add_parser("pull", help="download a model to the cache (no server)")
    pp.add_argument("repo", nargs="?", metavar="REPO_ID",
                    help="model id to download (or use a preset flag below)")
    add_model_flags(pp)
    pp.add_argument("-y", "--yes", action="store_true", help="skip the download-size prompt")
    pp.set_defaults(func=cmd_models_pull)
    rp = msub.add_parser("rm", help="delete a model from the cache to free disk")
    rp.add_argument("repo", nargs="?", metavar="REPO_ID",
                    help="model id to delete (or use a preset flag below)")
    add_model_flags(rp)
    rp.add_argument("-y", "--yes", action="store_true", help="skip the delete confirmation")
    rp.set_defaults(func=cmd_models_rm)
    cp = msub.add_parser("clean", help="remove stale *.incomplete temp files (frees disk)")
    cp.set_defaults(func=cmd_models_clean)
    syp = msub.add_parser("sync", help="register all downloaded models with pi")
    syp.set_defaults(func=cmd_models_sync)
    dp = msub.add_parser("doctor", help="clean + sync: tidy temp files and re-align pi")
    dp.set_defaults(func=cmd_models_doctor)

    sp = sub.add_parser("run", help="run the server in the foreground")
    add_model_flags(sp); server_opts(sp); sp.set_defaults(func=cmd_run)

    sp = sub.add_parser("pi", help="ensure server is up, then launch pi")
    add_model_flags(sp); server_opts(sp); sp.set_defaults(func=cmd_pi)

    sp = sub.add_parser("plist", help="generate a launchd plist (does not install)")
    add_model_flags(sp); server_opts(sp)
    sp.add_argument("-o", "--output", default="com.mlx-pi.server.plist", help="output path")
    sp.set_defaults(func=cmd_plist)

    default_bin = str(Path.home() / ".local" / "bin")
    sp = sub.add_parser("install", help="symlink mlx-pi onto your PATH (global command)")
    sp.add_argument("-d", "--dir", default=default_bin, help=f"target bin dir (default {default_bin})")
    sp.add_argument("-f", "--force", action="store_true", help="repoint an existing mlx-pi symlink")
    sp.set_defaults(func=cmd_install)

    sp = sub.add_parser("uninstall", help="remove the mlx-pi symlink from your PATH")
    sp.add_argument("-d", "--dir", default=default_bin, help=f"target bin dir (default {default_bin})")
    sp.set_defaults(func=cmd_uninstall)

    return p

def print_overview() -> None:
    """Friendly branded help shown when `mlx-pi` is run with no subcommand."""
    console.print("\n[bold cyan]🍎 mlx-pi[/] — run local LLMs on Apple Silicon with MLX + the pi agent.\n")
    console.print("[bold]Typical flow:[/]")
    console.print("  [cyan]mlx-pi setup[/]   one-time: install mlx-lm + mlx-vlm + pi, configure, make 'mlx-pi' global")
    console.print("  [cyan]mlx-pi up[/]      start the local model server (background)")
    console.print("  [cyan]mlx-pi pi[/]      launch the coding agent against it")
    console.print("  [cyan]mlx-pi down[/]    stop the server, free your RAM\n")

    groups = [
        ("Server lifecycle", [
            ("up", "start the MLX server in the background; wait until healthy"),
            ("down", "stop the background server"),
            ("restart", "down + up"),
            ("use", "switch the served model AND pi's default together (keeps them in sync)"),
            ("run", "run the server in the FOREGROUND (Ctrl-C to stop)"),
        ]),
        ("Inspect", [
            ("status", "show running state + health"),
            ("logs", "tail the server log"),
        ]),
        ("Models", [
            ("models", "list presets + downloaded models (and pi's choice)"),
            ("models pull", "download a model to the cache (no server)"),
            ("models rm", "delete a model from the cache to free disk"),
            ("models clean", "remove stale *.incomplete temp files"),
            ("models sync", "register all downloaded models with pi"),
            ("models doctor", "clean + sync in one step (tidy & re-align)"),
        ]),
        ("Agent & install", [
            ("setup", "install mlx-lm + mlx-vlm + pi, configure, symlink mlx-pi onto PATH"),
            ("pi", "ensure the server is up, then launch the pi agent"),
            ("install", "symlink mlx-pi onto your PATH (global command)"),
            ("uninstall", "remove that symlink"),
            ("plist", "generate a launchd plist for auto-start (does not install)"),
        ]),
    ]
    for title, rows in groups:
        t = Table(show_header=False, box=None, pad_edge=False)
        t.add_column(style="cyan", no_wrap=True)
        t.add_column(style="white")
        for name, desc in rows:
            t.add_row(f"mlx-pi {name}", desc)
        console.print(f"[bold]{title}[/]")
        console.print(t)
        console.print()
    console.print("[dim]Flags for any command:[/] [cyan]mlx-pi <command> --help[/]")
    console.print("[dim]Full illustrated guide:[/] https://curtisalexander.github.io/mlx-pi/\n")

def main() -> None:
    args = build_parser().parse_args()
    if not getattr(args, "func", None):
        print_overview()
        return
    if (getattr(args, "repo", None)
            and (getattr(args, "model", None) or getattr(args, "qwen_coder", False)
                 or getattr(args, "gemma", False))):
        err("Use either positional REPO_ID or a model selector flag, not both.")
        sys.exit(2)
    try:
        args.func(args)
    except KeyboardInterrupt:
        console.print("\n[dim]interrupted[/]")
        sys.exit(130)

if __name__ == "__main__":
    main()
