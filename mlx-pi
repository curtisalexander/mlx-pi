def sysctl(key: str) -> str:
    try:
        return subprocess.check_output(["sysctl", "-n", key], text=True).strip()
    except Exception:
        return ""

def ram_gb() -> int:
    try:
        return int(sysctl("hw.memsize")) // (1024 ** 3)
    except Exception:
        return 0

def require_apple_silicon() -> None:
    if platform.system() != "Darwin":
        err(f"macOS only (you're on {platform.system()}).")
        sys.exit(1)
    if platform.machine() != "arm64":
        err(f"MLX needs Apple Silicon (arm64); detected {platform.machine()}.")
        sys.exit(1)


# ============================================================================
#  HF cache & model state — what's downloaded, how big, complete vs partial
#  (We NEVER pull weights without telling you the size first.)
# ============================================================================

def hf_model_size_bytes(repo: str) -> int | None:
    """Sum the byte sizes of every file in the repo's main revision. None on failure."""
    url = f"https://huggingface.co/api/models/{repo}/tree/main?recursive=true"
    try:
        r = httpx.get(url, timeout=15, follow_redirects=True)
        r.raise_for_status()
        files = r.json()
        total = sum(f.get("size", 0) for f in files if f.get("type") == "file")
        return total or None
    except Exception:
        return None

def _cached_config(repo: str) -> dict | None:
    """Read a downloaded model's config.json from the local HF cache, if present.
    Avoids a network round-trip (and works offline) for models we already have."""
    snaps = HF_CACHE / f"models--{repo.replace('/', '--')}" / "snapshots"
    if not snaps.is_dir():
        return None
    base = snaps.parent
    candidates: list[Path] = []
    try:
        revision = (base / "refs" / "main").read_text().strip()
        if revision:
            candidates.append(snaps / revision)
    except OSError:
        pass
    candidates.extend(s for s in snaps.iterdir() if s not in candidates)
    for snap in candidates:
        cfg = snap / "config.json"
        if cfg.is_file():
            try:
                return json.loads(cfg.read_text())
            except (OSError, json.JSONDecodeError):
                return None
    return None

def _ctx_from_config(cfg: dict) -> int | None:
    """Pull the context length out of a HF config.json. Tries the common keys,
    including the text_config sub-config that VLMs nest their text model under."""
    for src in (cfg, cfg.get("text_config", {}), cfg.get("llm_config", {})):
        if not isinstance(src, dict):
            continue
        for key in ("max_position_embeddings", "n_positions", "n_ctx",
                    "max_sequence_length", "seq_length"):
            val = src.get(key)
            if isinstance(val, int) and not isinstance(val, bool) and 1024 <= val <= 10_000_000:
                return val
    return None

def hf_context_window(repo: str) -> int | None:
    """The model's max context length, from its config.json. Reads the local
    cache first (offline-friendly), else fetches config.json from HF. None on
    failure, so callers can fall back to DEFAULT_CONTEXT_WINDOW."""
    cfg = _cached_config(repo)
    if cfg is None:
        url = f"https://huggingface.co/{repo}/resolve/main/config.json"
        try:
            r = httpx.get(url, timeout=15, follow_redirects=True)
            r.raise_for_status()
            cfg = r.json()
        except Exception:
            return None
    return _ctx_from_config(cfg)

def model_is_cached(repo: str) -> bool:
    """True if the model already exists in the local HF cache (nothing to download)."""
    d = HF_CACHE / f"models--{repo.replace('/', '--')}"
    snaps = d / "snapshots"
    return snaps.is_dir() and any(snaps.iterdir())

def _active_incomplete(blobs: Path) -> bool:
    """True if any *.incomplete temp is a genuinely in-progress download. A temp
    is named '<sha>.<etag>.incomplete'; it's only active if its final blob
    '<sha>' is absent. Orphaned temps from earlier attempts whose blob already
    landed are stale leftovers and must be ignored — otherwise a fully
    downloaded model reads as 'partial' forever (HF never cleans them up)."""
    if not blobs.is_dir():
        return False
    return any(f.name.endswith(".incomplete") and not (blobs / f.name.split(".", 1)[0]).exists()
               for f in blobs.iterdir())

def model_status(repo: str) -> str:
    """'complete', 'partial', or 'absent' for a model in the local HF cache."""
    base = HF_CACHE / f"models--{repo.replace('/', '--')}"
    if not base.is_dir():
        return "absent"
    if _active_incomplete(base / "blobs"):
        return "partial"
    return "complete" if model_is_cached(repo) else "partial"

def prune_stale_incomplete(repo: str) -> int:
    """Delete orphaned *.incomplete temps (final blob already present) and return
    bytes freed. Never removes an active download (final blob still missing)."""
    blobs = HF_CACHE / f"models--{repo.replace('/', '--')}" / "blobs"
    if not blobs.is_dir():
        return 0
    freed = 0
    for f in blobs.iterdir():
        if f.name.endswith(".incomplete") and (blobs / f.name.split(".", 1)[0]).exists():
            try:
                freed += f.stat().st_size
                f.unlink()
            except OSError:
                pass
    return freed

def _present_repo_ids() -> list[str]:
    """Every MLX model with a cache dir (complete OR partial), as repo ids."""
    if not HF_CACHE.is_dir():
        return []
    return [d.name[len("models--"):].replace("--", "/")
            for d in HF_CACHE.iterdir()
            if d.is_dir() and d.name.startswith("models--")]

def cache_size_bytes(repo: str) -> int | None:
    """On-disk size of a cached model (sum of its blob files). None if absent."""
    blobs = HF_CACHE / f"models--{repo.replace('/', '--')}" / "blobs"
    if not blobs.is_dir():
        return None
    total = 0
    for f in blobs.iterdir():
        if f.name.endswith(".incomplete"):  # temp files aren't part of the model
            continue
        try:
            total += f.stat().st_size
        except OSError:
            pass
    return total

def _size(n: int | None) -> str:
    """Human-readable byte size (GB/MB/KB), so small cleanups don't read 0.0 GB."""
    if not n:
        return "—"
    for unit, scale in (("GB", 1024 ** 3), ("MB", 1024 ** 2), ("KB", 1024)):
        if n >= scale:
            return f"{n / scale:.1f} {unit}"
    return f"{n} B"

def confirm_download(repo: str, assume_yes: bool) -> bool:
    """Show download size + RAM estimate and ask to proceed. True = go ahead."""
    if model_is_cached(repo):
        ok(f"Model already in local cache — no download needed: {repo}")
        return True

    info(f"Querying Hugging Face for the size of: [bold]{repo}[/]")
    size = hf_model_size_bytes(repo)
    if size:
        gb_disk = size / 1024 ** 3
        gb_ram = gb_disk * 1.25  # rough: weights + context + overhead
        have_ram = ram_gb()
        console.print(f"  [bold]📦 Download size : ~{gb_disk:.1f} GB[/]   (to {HF_CACHE})")
        console.print(f"  [bold]🧠 RAM to run    : ~{gb_ram:.0f} GB[/]   "
                      f"(rough estimate; you have {have_ram} GB)")
        if have_ram and gb_ram > have_ram:
            warn("This model's estimated RAM need exceeds your installed memory!")
        size_str = f"{gb_disk:.1f} GB"
    else:
        warn("Couldn't read the size from Hugging Face (offline / bad id).")
        size_str = "unknown size"

    if assume_yes:
        info("--yes given — proceeding with download.")
        return True
    # Default is No, so an accidental Enter never starts a big download.
    return Confirm.ask(f"  [yellow]❓ Download this model (~{size_str}) now?[/]", default=False)


# ============================================================================
#  Model resolution (shared by several subcommands)
