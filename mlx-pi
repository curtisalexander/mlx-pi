def _download_cell(repo: str) -> str:
    """Rendered 'Downloaded' column for a repo, by cache status. For models not
    yet on disk, fall back to a live Hugging Face query so the table still shows
    the real download size (offline / unknown id → '— not yet')."""
    s = model_status(repo)
    if s == "complete":
        return f"[green]✅ {_size(cache_size_bytes(repo))}[/]"
    if s == "partial":
        return f"[yellow]⏳ partial ({_size(cache_size_bytes(repo))} so far)[/]"
    remote = hf_model_size_bytes(repo)
    if remote:
        return f"[dim]⬇ {_size(remote)} on HF[/]"
    return "[dim]— not yet[/]"

def cmd_models(args) -> None:
    configured = configured_model_id()
    registered = set(configured_model_ids())
    present = set(_present_repo_ids())
    preset_ids = {repo for _, repo, _ in PRESETS}

    def pi_cell(repo: str) -> str:
        if repo == configured:
            return "[bold green]▸[/]"
        return "[green]✓[/]" if repo in registered else ""

    t = Table(title="Presets", title_justify="left", title_style="bold",
              box=None, pad_edge=False)
    t.add_column("Flag", style="cyan", no_wrap=True)
    t.add_column("Model", style="white", overflow="fold")
    t.add_column("Type", style="dim")
    t.add_column("Downloaded")
    t.add_column("pi", justify="center")
    for flag, repo, modality in PRESETS:
        t.add_row(flag, repo, modality, _download_cell(repo), pi_cell(repo))
    console.print(t)
    console.print("  [dim]pi: ▸ = default · ✓ = also available · download with "
                  "[cyan]mlx-pi models pull[/], register with [cyan]mlx-pi models sync[/][/]")

    # Any other cached models that aren't presets — still usable via --model.
    others = sorted(present - preset_ids)
    if others:
        console.print()
        o = Table(title="Other downloaded models", title_justify="left",
                  title_style="bold", box=None, pad_edge=False)
        o.add_column("Model", style="white", overflow="fold")
        o.add_column("Downloaded")
        o.add_column("pi", justify="center")
        for repo in others:
            o.add_row(repo, _download_cell(repo), pi_cell(repo))
        console.print(o)
        console.print("  [dim]Use any with [cyan]mlx-pi up --model <id>[/] · "
                      "remove with [cyan]mlx-pi models rm <id>[/][/]")

    if configured and model_status(configured) == "partial":
        console.print()
        warn(f"pi's model [bold]{configured}[/] is only [yellow]partially[/] downloaded — "
             "run 'mlx-pi models pull' to resume and finish it (watch 'mlx-pi logs').")
    elif configured and model_status(configured) == "absent":
        console.print()
        warn(f"pi is configured for [bold]{configured}[/], which isn't downloaded yet — "
             "run 'mlx-pi models pull' to fetch it.")

def _hf_download(repo: str) -> None:
    """Pure download of a repo into the HF cache via huggingface_hub: no model
    load (so no RAM needed), resumes *.incomplete blobs, streams progress. Run
    through uv so the dependency is managed without polluting anything."""
    info(f"Downloading [bold]{repo}[/] → {HF_CACHE}")
    run(["uv", "run", "--with", "huggingface_hub", "python", "-c",
         "import sys; from huggingface_hub import snapshot_download; "
         "snapshot_download(sys.argv[1])", repo])

def _pull_done(model: str, verb: str) -> None:
    """Report a finished pull, prune stale temps, and register it with pi."""
    freed = prune_stale_incomplete(model)
    msg = f"{verb}: {model}  ({_size(cache_size_bytes(model))})"
    if freed:
        msg += f"  ·  cleaned up {_size(freed)} of leftover temp files"
    ok(msg)
    n = refresh_pi_models()  # keeps pi's default; adds the now-complete model
    if n is not None:
        info(f"pi now sees [bold]{n}[/] model(s) — open /model to pick it up.")

def cmd_models_pull(args) -> None:
    model = resolve_target_model(args)
    status = model_status(model)
    if status == "complete":
        _pull_done(model, "Already downloaded")
        return
    if status == "partial":
        info(f"Resuming partial download: {model}  ({_size(cache_size_bytes(model))} so far)")
    elif not confirm_download(model, args.yes):  # absent → show size + confirm
        warn("Download cancelled.")
        return
    _hf_download(model)
    if model_status(model) == "complete":
        _pull_done(model, "Downloaded")
    else:
        warn("Download ended but the model still looks incomplete — "
             "re-run 'mlx-pi models pull' to retry.")

def cmd_models_rm(args) -> None:
    model = resolve_target_model(args)
    base = HF_CACHE / f"models--{model.replace('/', '--')}"
    if not base.is_dir():
        warn(f"Not in cache — nothing to remove: {model}")
        return
    size = cache_size_bytes(model)
    if model == configured_model_id():
        warn(f"Heads up: pi is currently configured to use this model ({model}).")
    if not args.yes and not Confirm.ask(
            f"  [yellow]❓ Delete {model} ({_size(size)}) from the cache?[/]", default=False):
        warn("Cancelled.")
        return
    try:
        shutil.rmtree(base)
    except OSError as exc:
        err(f"Could not remove {model}: {exc}")
        return
    ok(f"Removed {model} — freed ~{_size(size)}.")
    n = refresh_pi_models()  # drop it from pi's list too
    if n is not None:
        info(f"pi now sees {n} model(s).")

def cmd_models_sync(args) -> None:
    """Rebuild pi's model list from the downloaded models in the cache."""
    n = refresh_pi_models()
    if n is None:
        warn("pi isn't configured yet — run 'mlx-pi setup' first.")
        return
    ids = configured_model_ids()
    ok(f"pi now sees {n} model(s):")
    for i, m in enumerate(ids):
        tag = "  [dim](default)[/]" if i == 0 else ""
        console.print(f"    [cyan]{m}[/]{tag}")
    info("Open /model inside pi to pick up the change.")

def cmd_models_clean(args) -> None:
    """Sweep stale *.incomplete temp files across every cached model. Safe:
    in-progress/interrupted downloads (final blob still missing) are kept."""
    freed = 0
    kept = []
    for repo in _present_repo_ids():
        freed += prune_stale_incomplete(repo)
        if model_status(repo) == "partial":
            kept.append(repo)
    if freed:
        ok(f"Cleaned up {_size(freed)} of stale temp files.")
    else:
        info("No stale temp files found — cache is already clean.")
    if kept:
        warn("Kept these in-progress/interrupted downloads "
             "(finish with 'mlx-pi models pull'):")
        for r in kept:
            console.print(f"    [yellow]⏳[/] {r}")

def cmd_models_doctor(args) -> None:
    """One-shot tidy-up: prune stale temp files, then re-align pi's model list
    with what's actually downloaded. Runs 'clean' then 'sync'."""
    step("1/2 · Cleaning stale temp files")
    cmd_models_clean(args)
    step("2/2 · Aligning pi's model list with the cache")
    cmd_models_sync(args)


