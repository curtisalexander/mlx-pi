def resolve_model(args) -> str:
    """Turn --model / --qwen-coder / --gemma flags into a concrete repo id."""
    if getattr(args, "qwen_coder", False):
        return QWEN_CODER_MODEL
    if getattr(args, "gemma", False):
        return GEMMA_MODEL
    if getattr(args, "model", None):
        return args.model
    env_model = os.environ.get("MLX_MODEL")
    if env_model is not None:
        if not env_model.strip():
            err("MLX_MODEL cannot be empty.")
            raise SystemExit(2)
        return env_model.strip()
    return DEFAULT_MODEL

def resolve_target_model(args) -> str:
    """Like resolve_model, but a positional REPO_ID (on `models pull`/`rm`) wins."""
    return getattr(args, "repo", None) or resolve_model(args)

def add_model_flags(p: argparse.ArgumentParser) -> None:
    """Attach the common model-selection flags to a subparser."""
    group = p.add_mutually_exclusive_group()
    group.add_argument("-m", "--model", metavar="REPO_ID",
                       help=f"Hugging Face MLX model id, e.g. '{DEFAULT_MODEL}' "
                            "(browse https://huggingface.co/mlx-community)")
    group.add_argument("--qwen-coder", action="store_true",
                       help=f"Preset: {QWEN_CODER_MODEL}")
    group.add_argument("--gemma", action="store_true",
                       help=f"Preset: {GEMMA_MODEL} (text+image)")

def _port(value: str) -> int:
    try:
        port = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError("port must be an integer")
    if not 1 <= port <= 65535:
        raise argparse.ArgumentTypeError("port must be between 1 and 65535")
    return port

def _is_loopback_host(host: str) -> bool:
    if host.lower() == "localhost":
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False

def _network_bind_allowed(args) -> bool:
    if _is_loopback_host(args.host):
        return True
    if getattr(args, "allow_network", False):
        warn(f"Binding to {args.host} exposes an unauthenticated model API to the network.")
        return True
    err(f"Refusing non-loopback bind {args.host!r} without --allow-network.")
    info("MLX's server has only basic security checks; use a firewall or trusted network.")
    return False


# ============================================================================
#  pi configuration (registering local-mlx models in ~/.pi/agent/models.json)
# ============================================================================

def _pin_enabled() -> bool:
    """Single-model (pinned) mode: register ONLY the chosen model with pi, so
    pi can't drift to a different model and silently trigger a server hot-swap
    /reload. Toggle with MLX_PIN_MODEL=1 (or the --pin flag on setup/use)."""
    return os.environ.get("MLX_PIN_MODEL", "").strip().lower() in ("1", "true", "yes", "on")

def _ram_guard_enabled() -> bool:
    """Whether to hide models that almost certainly won't fit in RAM from pi's
    picker, so selecting one can't OOM the box. On by default; disable with
    MLX_NO_RAM_GUARD=1 (or when you've added swap / know better)."""
    return os.environ.get("MLX_NO_RAM_GUARD", "").strip().lower() not in ("1", "true", "yes", "on")

def _est_ram_gb(repo: str) -> float | None:
    """Rough RAM (GB) to load a cached model: on-disk weights + ~25% overhead
    (matches confirm_download's estimate). None if it isn't cached to size."""
    b = cache_size_bytes(repo)
    return (b / 1024 ** 3) * 1.25 if b else None

def _fits_ram(repo: str) -> bool:
    """True unless we're confident the model exceeds installed RAM. An unknown
    size or unknown RAM → True: never block a model on a guess."""
    have = ram_gb()
    est = _est_ram_gb(repo)
    if not have or est is None:
        return True
    return est <= have

def is_vision_model(repo: str) -> bool:
    """Best-effort: is this a Vision-Language Model (accepts image input)?

    This is the single source of truth that decides BOTH which server backend
    runs the model (mlx_vlm.server for vision, mlx_lm.server for text-only) AND
    whether pi advertises image input — so the two can never disagree. It's a
    cached config metadata is preferred over the name heuristic; explicit env
    overrides remain authoritative for unusual repositories."""
    forced_vision = _env_id_set("MLX_VISION_MODELS")
    forced_text = _env_id_set("MLX_TEXT_MODELS")
    if repo in forced_vision and repo in forced_text:
        err(f"{repo} appears in both MLX_VISION_MODELS and MLX_TEXT_MODELS.")
        raise SystemExit(2)
    if repo in forced_vision:
        return True
    if repo in forced_text:
        return False
    cfg = _cached_config(repo)
    if cfg is not None:
        detected = _vision_from_config(cfg)
        if detected is not None:
            return detected
    r = repo.lower()
    return (repo == GEMMA_MODEL or "gemma-4" in r or "-vl" in r or "vision" in r
            or "llava" in r or "pixtral" in r or "idefics" in r or "moondream" in r
            or "smolvlm" in r or "-vlm" in r)

def _vision_from_config(cfg: dict) -> bool | None:
    """Infer modality from common Hugging Face model metadata when decisive."""
    if isinstance(cfg.get("vision_config"), dict):
        return True
    values = [cfg.get("model_type", "")]
    values.extend(cfg.get("architectures") or [])
    text = " ".join(str(v).lower() for v in values)
    vision_markers = ("vision", "vlconditional", "llava", "pixtral", "idefics",
                      "moondream", "smolvlm", "qwen2vl", "qwen3vl", "gemma4")
    if any(marker in text.replace("_", "") for marker in vision_markers):
        return True
    # A recognized causal-LM architecture without a vision section is useful
    # negative evidence. Unknown/custom configs fall back to the name heuristic.
    if any(marker in text for marker in ("causallm", "forcausallm")):
        return False
    return None

def _env_id_set(var: str) -> set[str]:
    """Comma/space-separated repo ids from an env var, as a set (empty if unset)."""
    return {s.strip() for s in re.split(r"[,\s]+", os.environ.get(var, "")) if s.strip()}

def _pi_model_entry(repo: str) -> dict:
    """One pi models.json entry for a model repo id."""
    ctx = hf_context_window(repo) or DEFAULT_CONTEXT_WINDOW
    return {
        "id": repo,
        "name": f"MLX · {repo.split('/')[-1]}",
        "reasoning": False,
        "input": ["text", "image"] if is_vision_model(repo) else ["text"],
        "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
        "contextWindow": ctx,
        # Keep the output cap under the context window so a small-context model
        # still has room for the prompt. The big presets (256K ctx) just get the
        # full DEFAULT_MAX_TOKENS; an 8K-ctx model is held to ~half its window.
        "maxTokens": min(DEFAULT_MAX_TOKENS, ctx // 2),
    }

def _pi_model_ids(primary: str | None = None, force_primary: bool = False,
                  backend: str | None = None) -> list[str]:
    """Repo ids to expose to pi: `primary` first (if forced, or already
    downloaded), then compatible fully-downloaded models in the cache.

    Two policies can trim that list:
      • pinned mode (MLX_PIN_MODEL)  → only the primary, so pi can't drift.
      • RAM guard (on by default)    → drop models that clearly won't fit in
        RAM, EXCEPT the primary (you explicitly asked for that one)."""
    backend = backend or (backend_kind(primary) if primary else None)
    complete = sorted(r for r in _present_repo_ids()
                      if model_status(r) == "complete"
                      and (backend is None or backend_kind(r) == backend))
    kept_primary = primary if (primary and (force_primary or primary in complete)) else None
    if _pin_enabled() and kept_primary:
        return [kept_primary]
    ids: list[str] = []
    if kept_primary:
        ids.append(kept_primary)
    for r in complete:
        if r in ids:
            continue
        if _ram_guard_enabled() and not _fits_ram(r):
            continue  # too big for this machine — _warn_ram_dropped() surfaces it
        ids.append(r)
    return ids

def _ram_dropped(ids: list[str]) -> list[str]:
    """Downloaded models the RAM guard excluded from `ids` — so callers can tell
    the user instead of silently hiding them ('no silent caps')."""
    if not _ram_guard_enabled():
        return []
    backend = backend_kind(ids[0]) if ids else None
    return [r for r in sorted(_present_repo_ids())
            if model_status(r) == "complete" and r not in ids and not _fits_ram(r)
            and (backend is None or backend_kind(r) == backend)]

def _warn_ram_dropped(ids: list[str]) -> None:
    """Best-effort heads-up about models hidden from pi for not fitting in RAM."""
    dropped = _ram_dropped(ids)
    if not dropped:
        return
    warn(f"Hid {len(dropped)} model(s) from pi that likely exceed your "
         f"{ram_gb()} GB RAM (set MLX_NO_RAM_GUARD=1 to register them anyway):")
    for r in dropped:
        est = _est_ram_gb(r)
        tag = f"  [dim](~{est:.0f} GB to load)[/]" if est else ""
        console.print(f"    [yellow]🧠[/] {r}{tag}")

def _warn_backend_dropped(ids: list[str]) -> None:
    if not ids:
        return
    backend = backend_kind(ids[0])
    dropped = [r for r in sorted(_present_repo_ids())
               if model_status(r) == "complete" and backend_kind(r) != backend]
    if dropped:
        label = "vision" if backend == "vlm" else "text"
        info(f"pi lists only {label}-backend models while this backend is active; "
             f"switch others with 'mlx-pi use <model>'.")

def _pi_lock_path() -> Path:
    return PI_CONFIG_DIR / ".mlx-pi.lock"

def _backup(path: Path) -> Path:
    backup = path.with_suffix(f"{path.suffix}.bak.{time.time_ns()}")
    _atomic_write(backup, path.read_bytes())
    for old in sorted(path.parent.glob(f"{path.name}.bak.*"))[:-5]:
        old.unlink(missing_ok=True)
    return backup

def _read_json_or_abort(path: Path) -> dict:
    try:
        data = json.loads(path.read_text())
        if not isinstance(data, dict):
            raise ValueError("top level is not an object")
        return data
    except Exception as exc:
        backup = _backup(path)
        err(f"Refusing to overwrite malformed JSON in {path}: {exc}")
        info(f"A copy was saved as {backup.name}; repair the file and retry.")
        raise SystemExit(1)

def configure_pi(model: str, base_url: str) -> None:
    """Write/merge the local-mlx provider into pi's models.json (native JSON — no
    heredocs!). Registers the selected model plus compatible downloads."""
    PI_CONFIG_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    ids = _pi_model_ids(primary=model, force_primary=True, backend=backend_kind(model))
    with _file_lock(_pi_lock_path()):
        provider = {
            "baseUrl": base_url,
            "api": "openai-completions",
            "apiKey": "local-mlx-no-key-needed",  # required by client, ignored by MLX
            "models": [_pi_model_entry(r) for r in ids],
        }
        if PI_CONFIG_FILE.exists():
            backup = _backup(PI_CONFIG_FILE)
            info(f"Existing config backed up → {backup.name}")
            data = _read_json_or_abort(PI_CONFIG_FILE)
        else:
            data = {}
        data.setdefault("providers", {})[PI_PROVIDER_ID] = provider
        _atomic_write_json(PI_CONFIG_FILE, data)
        _set_pi_default_unlocked(model)
    suffix = "  [dim](pinned: only this model)[/]" if _pin_enabled() else ""
    ok(f"Configured provider '{PI_PROVIDER_ID}' with {len(ids)} model(s) → {base_url}{suffix}")
    info(f"pi will open on [bold]{model}[/] by default.")
    _warn_ram_dropped(ids)
    _warn_backend_dropped(ids)

def refresh_pi_models(primary: str | None = None, force_primary: bool = False) -> int | None:
    """Rewrite the local-mlx provider's model list from the cache, preserving its
    baseUrl/api/key. Keeps the current default first unless `primary` is given.
    Returns the new model count, or None if pi isn't configured yet."""
    if not PI_CONFIG_FILE.exists():
        return None
    with _file_lock(_pi_lock_path()):
        data = _read_json_or_abort(PI_CONFIG_FILE)
        prov = data.get("providers", {}).get(PI_PROVIDER_ID)
        if not isinstance(prov, dict):
            return None
        settings = pi_settings()
        global_default = (settings.get("defaultModel")
                          if settings.get("defaultProvider") == PI_PROVIDER_ID else None)
        if primary is None:
            primary = global_default
            if not primary:
                cur = prov.get("models") or []
                primary = cur[0].get("id") if cur else None
        if primary is None:
            state = _read_server_state()
            complete = sorted(r for r in _present_repo_ids() if model_status(r) == "complete")
            if _state_is_owned(state):
                same_backend = [r for r in complete if backend_kind(r) == state["backend"]]
                primary = same_backend[0] if same_backend else None
            elif complete:
                primary = complete[0]
        backend = backend_kind(primary) if primary else None
        ids = _pi_model_ids(primary=primary, force_primary=force_primary, backend=backend)
        prov["models"] = [_pi_model_entry(r) for r in ids]
        _atomic_write_json(PI_CONFIG_FILE, data)
        if force_primary and primary:
            _set_pi_default_unlocked(primary)
        elif global_default and global_default not in ids:
            if ids:
                _set_pi_default_unlocked(ids[0])
            else:
                _clear_pi_default_unlocked()
    _warn_ram_dropped(ids)
    _warn_backend_dropped(ids)
    return len(ids)

def pi_settings() -> dict:
    """pi's settings.json (where its startup model lives), or {} if unreadable."""
    try:
        return json.loads(PI_SETTINGS_FILE.read_text())
    except Exception:
        return {}

def set_pi_default(model: str) -> None:
    """Make `model` pi's startup default. pi reads its opening model from
    settings.json (defaultProvider + defaultModel), NOT the models.json list
    order — so writing here is what actually changes which model pi opens with.
    Merges (preserving other settings) and keeps the 5 most recent backups."""
    with _file_lock(_pi_lock_path()):
        _set_pi_default_unlocked(model)

def _set_pi_default_unlocked(model: str) -> None:
    PI_CONFIG_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    if PI_SETTINGS_FILE.exists():
        s = _read_json_or_abort(PI_SETTINGS_FILE)
        _backup(PI_SETTINGS_FILE)
    else:
        s = {}
    s["defaultProvider"] = PI_PROVIDER_ID
    s["defaultModel"] = model
    _atomic_write_json(PI_SETTINGS_FILE, s)

def _clear_pi_default_unlocked() -> None:
    if not PI_SETTINGS_FILE.exists():
        return
    s = _read_json_or_abort(PI_SETTINGS_FILE)
    if s.get("defaultProvider") != PI_PROVIDER_ID:
        return
    _backup(PI_SETTINGS_FILE)
    s.pop("defaultProvider", None)
    s.pop("defaultModel", None)
    _atomic_write_json(PI_SETTINGS_FILE, s)

def configured_model_id() -> str | None:
    """pi's actual startup model. Read from settings.json (defaultProvider +
    defaultModel) — the list order in models.json does NOT decide this. Falls
    back to the first registered model only when settings name no default for
    our provider; None if pi defaults to a different provider entirely."""
    s = pi_settings()
    prov = s.get("defaultProvider")
    if prov == PI_PROVIDER_ID and s.get("defaultModel"):
        return s["defaultModel"]
    if prov and prov != PI_PROVIDER_ID:
        return None  # pi opens on a different provider — none of ours is default
    ids = configured_model_ids()
    return ids[0] if ids else None

def configured_model_ids() -> list[str]:
    """Every model id registered with pi's local-mlx provider (default first)."""
    try:
        data = json.loads(PI_CONFIG_FILE.read_text())
        return [m["id"] for m in data["providers"][PI_PROVIDER_ID]["models"]]
    except Exception:
        return []

def align_pi_default(model: str, port: int) -> int | None:
    """Make `model` pi's startup default: register it (or create the provider
    config if pi isn't set up yet) and set it as defaultModel. Returns pi's
    model count. The single place the 'point pi at this model' step lives, so
    `use` and `pi --<model>` behave identically."""
    if PI_CONFIG_FILE.exists():
        return refresh_pi_models(primary=model, force_primary=True)
    configure_pi(model, f"http://localhost:{port}/v1")
    return len(configured_model_ids())


# ============================================================================
#  Server process management (owned state + health checks + log helpers)
# ============================================================================

def _read_server_state() -> dict | None:
    try:
        state = json.loads(STATE_FILE.read_text())
        return state if state.get("version") == 1 else None
    except Exception:
        return None

def _process_identity(pid: int) -> dict | None:
    """Opaque process identity used to reject stale/reused PIDs before signals."""
    try:
        env = {**os.environ, "LC_ALL": "C"}
        started = subprocess.check_output(
            ["ps", "-ww", "-p", str(pid), "-o", "lstart="], text=True, env=env,
        ).strip()
        pgid = int(subprocess.check_output(
            ["ps", "-ww", "-p", str(pid), "-o", "pgid="], text=True, env=env,
        ).strip())
        command = subprocess.check_output(
            ["ps", "-ww", "-p", str(pid), "-o", "command="], text=True, env=env,
        ).strip()
        if not started or not command:
            return None
        return {"started": started, "pgid": pgid, "command": command}
    except Exception:
        return None

def _state_is_owned(state: dict | None) -> bool:
    if not state:
        return False
    identity = _process_identity(state.get("pid", -1))
    if not identity:
        return False
    return (identity.get("started") == state.get("started")
            and identity.get("pgid") == state.get("pgid") == state.get("pid")
            and identity.get("command") == state.get("command")
            and state.get("backend") in ("lm", "vlm"))

def _remove_state(instance: str | None = None) -> None:
    current = _read_server_state()
    if instance is None or (current and current.get("instance") == instance):
        STATE_FILE.unlink(missing_ok=True)

def server_pid() -> int | None:
    state = _read_server_state()
    if _state_is_owned(state):
        return state["pid"]
    if state:
        _remove_state(state.get("instance"))
    return None

def _probe_host(host: str) -> str:
    if host == "0.0.0.0":
        return "127.0.0.1"
    if host == "::":
        return "::1"
    return host

def _local_url(host: str, port: int, path: str) -> str:
    host = _probe_host(host)
    rendered = f"[{host}]" if ":" in host and not host.startswith("[") else host
    return f"http://{rendered}:{port}{path}"

def _port_in_use(host: str, port: int) -> bool:
    probe = _probe_host(host)
    family = socket.AF_INET6 if ":" in probe else socket.AF_INET
    try:
        with socket.socket(family, socket.SOCK_STREAM) as sock:
            sock.settimeout(0.25)
            return sock.connect_ex((probe, port)) == 0
    except OSError:
        return False

def is_healthy(host: str, port: int) -> bool:
    try:
        with httpx.Client(trust_env=False, timeout=2) as client:
            r = client.get(_local_url(host, port, "/health"))
        return r.status_code == 200 and r.json().get("status") in ("ok", "healthy")
    except Exception:
        return False

def server_ready(host: str, port: int, backend: str, model: str,
                 timeout: float = 2) -> bool:
    """One backend-specific startup probe (caller polls liveness separately)."""
    try:
        with httpx.Client(trust_env=False, timeout=timeout) as client:
            if backend == "vlm":
                r = client.get(_local_url(host, port, "/health"))
                if r.status_code != 200:
                    return False
                data = r.json()
                if data.get("status") not in ("ok", "healthy"):
                    return False
                return data.get("loaded_model") == model
            # mlx-lm's /health is liveness only; a tiny completion proves that
            # asynchronous model loading has finished before pi is launched.
            probe = client.post(
                _local_url(host, port, "/v1/chat/completions"),
                json={"model": model, "messages": [{"role": "user", "content": "Reply ok."}],
                      "max_tokens": 1, "stream": False},
            )
            return probe.status_code == 200
    except Exception:
        return False

def _wait_until_ready(host: str, port: int, backend: str, model: str,
                      deadline: float, alive) -> bool:
    """Poll cheap liveness, then make at most one LM generation request."""
    while time.monotonic() < deadline:
        if not alive():
            return False
        if backend == "vlm":
            if server_ready(host, port, backend, model):
                return alive()
        elif is_healthy(host, port):
            remaining = max(0.1, deadline - time.monotonic())
            return server_ready(host, port, backend, model, timeout=remaining) and alive()
        console.print(f"  [dim]…still warming up[/]", end="\r")
        time.sleep(1)
    return False

def served_model(pid: int) -> str | None:
    state = _read_server_state()
    return state.get("model") if _state_is_owned(state) and state.get("pid") == pid else None

def server_backend(pid: int) -> str | None:
    state = _read_server_state()
    return state.get("backend") if _state_is_owned(state) and state.get("pid") == pid else None

def _model_requested(args) -> bool:
    """True if the user explicitly chose a model (flag or MLX_MODEL), vs the
    implicit default — so we only warn about a mismatch when they actually asked."""
    return bool(getattr(args, "qwen_coder", False) or getattr(args, "gemma", False)
                or getattr(args, "model", None) or os.environ.get("MLX_MODEL"))

# Two backends, picked per-model by is_vision_model():
#   • mlx_lm.server  (Apple's ml-explore) — text-only LLMs.
#   • mlx_vlm.server (community: Blaizzy/mlx-vlm) — Vision-Language Models, the
#     only one of the two that accepts image input. Both expose the OpenAI-compatible
#     chat route pi needs, but their health/readiness details differ.
LM_SERVER = "mlx_lm.server"
VLM_SERVER = "mlx_vlm.server"

def backend_name(model: str) -> str:
    """The server binary name that serves `model` (vision → mlx_vlm.server)."""
    return VLM_SERVER if is_vision_model(model) else LM_SERVER

def backend_kind(model: str) -> str:
    """Short backend code for `model` — 'vlm' or 'lm'. This is the SAME vocabulary
    server_backend() reads back from a running process, so compare against this
    (never backend_name(), whose full binary names like 'mlx_lm.server' never
    equal 'lm' and would falsely flag a correct backend as wrong)."""
    return "vlm" if is_vision_model(model) else "lm"

def server_bin(model: str | None = None) -> str:
    """Absolute path to the server binary for `model`'s backend (uv installs both
    to ~/.local/bin). With no model, defaults to the text backend."""
    name = backend_name(model) if model else LM_SERVER
    return have(name) or str(Path.home() / ".local" / "bin" / name)

def generate_bin(model: str) -> str:
    """The one-shot generate CLI matching `model`'s backend (for prefetch warms)."""
    name = "mlx_vlm.generate" if is_vision_model(model) else "mlx_lm.generate"
    return have(name) or str(Path.home() / ".local" / "bin" / name)

def require_backend(model: str) -> None:
    """Ensure the server binary for `model`'s backend is installed."""
    name = backend_name(model)
    if not have(name):
        pkg = "mlx-vlm" if name == VLM_SERVER else "mlx-lm"
        err(f"{name} not found — needed to serve [bold]{model}[/].")
        console.print(f"  [dim]Install it with [cyan]uv tool install {pkg}[/] (or re-run "
                      "[cyan]./mlx-pi setup[/]), then open a new terminal.[/]")
        sys.exit(1)

def trim_log(limit: int | None = None) -> None:
    """Cap server.log: if it exceeds LOG_MAX_BYTES, keep only the most recent
    half (snapped to a line boundary) and drop the older head. Best-effort —
    any error here must never block starting the server."""
    try:
        limit = limit or _positive_env_int("MLX_LOG_MAX_BYTES", DEFAULT_LOG_MAX_BYTES)
        if not LOG_FILE.exists() or LOG_FILE.stat().st_size <= limit:
            return
        keep = limit // 2
        with open(LOG_FILE, "rb") as f:
            f.seek(-keep, os.SEEK_END)
            tail = f.read()
        # Drop the partial first line so the kept log starts cleanly.
        nl = tail.find(b"\n")
        if nl != -1:
            tail = tail[nl + 1:]
        with open(LOG_FILE, "wb") as f:
            f.write(b"--- log trimmed (exceeded %d bytes) ---\n" % limit)
            f.write(tail)
    except OSError:
        pass

def _tail(path: Path, n: int) -> None:
    """Print the last n lines of a file (best-effort, for error context)."""
    try:
        lines = path.read_text(errors="replace").splitlines()
    except OSError:
        return
    for line in lines[-n:]:
        console.print(f"  [dim]{line}[/]")


