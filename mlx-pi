def cmd_setup(args) -> None:
    model = resolve_model(args)
    port = args.port
    base_url = f"http://localhost:{port}/v1"
    if getattr(args, "pin", False):
        os.environ["MLX_PIN_MODEL"] = "1"  # configure_pi() registers only `model`

    console.print("\n[bold cyan]🍎 mlx-pi setup — MLX + pi for Apple Silicon[/]")
    info(f"Model:    [bold]{model}[/]")
    info(f"pi URL:   [bold]{base_url}[/]")

    # --- 1. Platform -------------------------------------------------------
    step("Step 1/6 · Checking your machine")
    require_apple_silicon()
    chip = sysctl("machdep.cpu.brand_string") or "Apple Silicon"
    ok(f"Running on [bold]{chip}[/] with [bold]{ram_gb()} GB[/] unified memory")

    # --- 2. mlx-lm + mlx-vlm (global uv tools) ----------------------------
    step("Step 2/6 · Installing the MLX server backends (uv tools)")
    if not have("uv"):
        err("uv not found. Run ./bootstrap.sh first.")
        sys.exit(1)
    # Two backends, isolated envs, CLIs exposed globally on PATH:
    #   mlx-lm  (Apple's ml-explore) — text-only LLMs → mlx_lm.server
    #   mlx-vlm (community Blaizzy/mlx-vlm) — vision models → mlx_vlm.server,
    #           the only backend that accepts image input.
    # --upgrade makes this idempotent (installs or updates a single global copy).
    run(["uv", "tool", "install", "--upgrade", "mlx-lm"])
    if have("mlx_lm.server"):
        ok("mlx-lm ready — mlx_lm.server / generate / chat are on PATH (text models)")
    else:
        warn("mlx-lm installed but not yet on PATH — open a new terminal (or run 'uv tool update-shell').")
    run(["uv", "tool", "install", "--upgrade", "mlx-vlm"])
    if have("mlx_vlm.server"):
        ok("mlx-vlm ready — mlx_vlm.server / generate on PATH (vision models, e.g. Gemma)")
    else:
        warn("mlx-vlm installed but not yet on PATH — open a new terminal (or run 'uv tool update-shell').")

    # --- 3. Node + pi -----------------------------------------------------
    step("Step 3/6 · Installing Node.js + pi harness")
    if not have("node"):
        if have("brew"):
            run(["brew", "install", "node"])
        else:
            err("Node.js required for pi, and Homebrew isn't installed.")
            console.print("     Fix: install Node from https://nodejs.org (LTS), then re-run.")
            sys.exit(1)
    else:
        ok(f"Node present ({subprocess.check_output(['node', '--version'], text=True).strip()})")
    # --ignore-scripts is the latest recommended install: pi needs no lifecycle
    # scripts, so skipping them is faster and avoids running arbitrary scripts.
    run(["npm", "install", "-g", "--ignore-scripts", PI_NPM_PKG])
    ok("pi installed") if have("pi") else warn("pi not on PATH — check `npm root -g`.")

    # --- 4. Configure pi --> local server ---------------------------------
    step("Step 4/6 · Pointing pi at the local MLX server")
    configure_pi(model, base_url)

    # --- 5. Optional prefetch (with size confirmation) --------------------
    step("Step 5/6 · Model download")
    if args.prefetch:
        if confirm_download(model, args.yes):
            if is_vision_model(model):
                # A vision warm-up needs an image; just download the weights.
                info(f"Downloading {model} (vision model) …")
                _hf_download(model)
                ok("Model downloaded.")
            else:
                info(f"Downloading & warming {model} …")
                run([generate_bin(model),
                     "--model", model, "--prompt", "Say ok.", "--max-tokens", "1"])
                ok("Model downloaded and verified.")
        else:
            warn("Download skipped — the server will fetch it on first 'up'.")
    else:
        info("Skipping download. './mlx-pi up' will fetch it (with a size check) on first use.")

    # --- 6. Global command (PATH symlink) ---------------------------------
    step("Step 6/6 · Making 'mlx-pi' a global command")
    linked = False
    if args.no_link:
        info("Skipping PATH symlink (--no-link). Run 'mlx-pi install' later if you want it.")
    else:
        link_dir = Path.home() / ".local" / "bin"
        linked = install_symlink(link_dir) and _on_path(link_dir)

    _print_setup_summary(model, linked=linked)

def _print_setup_summary(model: str, linked: bool = True) -> None:
    p = "mlx-pi" if linked else "./mlx-pi"
    console.print()
    console.print(Panel("[bold green]✅  SETUP COMPLETE[/]",
                        expand=False, padding=(0, 4), border_style="green"))
    console.print("\n[bold]Next steps:[/]")
    console.print(f"  1️⃣  [cyan]{p} up[/]      start the MLX server (background)")
    console.print(f"  2️⃣  [cyan]{p} pi[/]      launch the coding agent")
    console.print(f"  3️⃣  [cyan]{p} down[/]    stop & free memory")
    r = ram_gb()
    console.print(f"\n[bold]Memory note[/] (you have {r} GB):")
    if r >= 64:
        console.print("  [green]Plenty of headroom — --qwen-coder (30B MoE) flies, "
                      "--gemma (8-bit, ~33 GB) fits, and 70B-class 4-bit too.[/]")
    elif r >= 32:
        console.print("  [green]Great for --qwen-coder (30B MoE, ~20 GB). "
                      "--gemma (~33 GB) is too big here — it needs 64 GB.[/]")
    elif r >= 16:
        console.print("  [green]The small default Qwen3 4B is ideal here; 30B will be tight.[/]")
    else:
        console.print("  [yellow]Stick to ~3–4B 4-bit models.[/]")
    console.print("\n[bold]Optional — run at login:[/] generate a launchd file with "
                  "[cyan]./mlx-pi plist[/] (it won't install it; see the HTML guide).")
    console.print("[dim]If 'mlx_lm.server', 'mlx_vlm.server' or 'pi' aren't found, open a NEW terminal so PATH refreshes.[/]")


