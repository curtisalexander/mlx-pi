#  SUBCOMMANDS: server lifecycle — up / down / restart / status / logs / run / pi
# ============================================================================

def _terminate_owned(state: dict, proc: subprocess.Popen | None = None) -> bool:
    """Stop exactly the process group represented by verified state."""
    if not _state_is_owned(state):
        return False
    try:
        os.killpg(state["pgid"], signal.SIGTERM)
    except OSError:
        pass
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        if proc is not None and proc.poll() is not None:
            break
        if proc is None and not _state_is_owned(state):
            break
        time.sleep(0.2)
    else:
        if _state_is_owned(state):
            warn("Graceful stop timed out — force killing the owned process group.")
            try:
                os.killpg(state["pgid"], signal.SIGKILL)
            except OSError:
                pass
    if proc is not None:
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            pass
    _remove_state(state.get("instance"))
    return True

def _terminate_spawn(proc: subprocess.Popen) -> None:
    """Best-effort cleanup before owned state has been safely published."""
    if proc.poll() is None:
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except OSError:
            proc.terminate()
    try:
        proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            proc.kill()
        proc.wait(timeout=2)

def _stop_locked() -> bool:
    state = _read_server_state()
    if not state:
        if LEGACY_PID_FILE.exists():
            warn(f"Found legacy {LEGACY_PID_FILE.name}; it cannot be safely verified "
                 "and will not be signaled. Removing the stale tracking file.")
            LEGACY_PID_FILE.unlink(missing_ok=True)
        info("No running server tracked. (Already off 🔴)")
        return False
    if not _state_is_owned(state):
        warn("Tracked server identity no longer matches that process — refusing to signal it.")
        _remove_state(state.get("instance"))
        return False
    info(f"Stopping MLX server (PID {state['pid']})…")
    _terminate_owned(state)
    ok("MLX server stopped 🔴")
    return True

def _start_locked(args, model: str, *, force_restart: bool = False) -> bool:
    timeout = _positive_env_int("MLX_STARTUP_TIMEOUT", 600)
    log_limit = _positive_env_int("MLX_LOG_MAX_BYTES", DEFAULT_LOG_MAX_BYTES)
    host, port = args.host, args.port
    expected_backend = backend_kind(model)
    state = _read_server_state()
    if state and _state_is_owned(state):
        healthy = is_healthy(state["host"], state["port"])
        explicit_model_change = _model_requested(args) and state["model"] != model
        endpoint_change = state["host"] != host or state["port"] != port
        backend_change = _model_requested(args) and state["backend"] != expected_backend
        changed = explicit_model_change or endpoint_change or backend_change
        if not force_restart and not changed and state.get("phase") == "ready" and healthy:
            ok(f"MLX server is already up & healthy 🟢  →  {_local_url(host, port, '')}")
            info(f"Currently serving: [bold]{state['model']}[/]")
            return True
        if not force_restart and not changed and state.get("phase") != "ready":
            info("Recovering a server whose startup was already in progress…")
            ready = _wait_until_ready(
                state["host"], state["port"], state["backend"], state["model"],
                time.monotonic() + timeout, lambda: _state_is_owned(state),
            )
            if ready:
                state["phase"] = "ready"
                _atomic_write_json(STATE_FILE, state)
                ok(f"MLX server is UP and HEALTHY 🟢  →  {_local_url(host, port, '')}")
                return True
            err(f"Existing startup did not become ready within {timeout}s; stopping it.")
            _stop_locked()
            return False
        warn("Restarting the owned server to restore the requested healthy state.")
        _stop_locked()
    elif state:
        warn("Discarding stale server state; its process identity no longer matches.")
        _remove_state(state.get("instance"))

    if _port_in_use(host, port):
        err(f"Port {port} is already in use by a process mlx-pi does not own.")
        info("Stop that service or choose another --port; mlx-pi will not signal it.")
        return False

    STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(STATE_DIR, 0o700)
    trim_log(log_limit)
    bin_path = server_bin(model)
    kind = "vision (mlx_vlm.server)" if is_vision_model(model) else "text (mlx_lm.server)"
    info("Starting MLX server (background daemon)…")
    info(f"  model: [bold]{model}[/]   bind: [bold]{host}:{port}[/]")
    info(f"  backend: [bold]{kind}[/]")
    info(f"  log  : {LOG_FILE}")

    # Launch detached: start_new_session puts it in its own process group so it
    # survives this CLI exiting; output is appended to the log file.
    command = [bin_path, "--model", model, "--host", host,
               "--port", str(port), "--max-tokens", str(DEFAULT_MAX_TOKENS)]
    with open(LOG_FILE, "a") as logf:
        proc = subprocess.Popen(command, stdout=logf, stderr=subprocess.STDOUT,
                                start_new_session=True)
    identity = None
    for _ in range(10):
        identity = _process_identity(proc.pid)
        if identity or proc.poll() is not None:
            break
        time.sleep(0.05)
    if not identity or identity["pgid"] != proc.pid:
        _terminate_spawn(proc)
        err("Could not verify the new server process identity; it was stopped safely.")
        return False
    state = {
        "version": 1, "instance": str(uuid.uuid4()), "phase": "starting",
        "pid": proc.pid, **identity, "backend": expected_backend, "model": model,
        "host": host, "port": port,
    }
    try:
        _atomic_write_json(STATE_FILE, state)
    except BaseException:
        _terminate_spawn(proc)
        raise
    info(f"PID {proc.pid} — waiting for it to become healthy…")

    # First run may download the model, so wait generously. LM uses cheap health
    # polling followed by one completion request; timed-out requests are not
    # retried because mlx-lm may continue processing them after the client leaves.
    try:
        ready = _wait_until_ready(
            host, port, expected_backend, model, time.monotonic() + timeout,
            lambda: proc.poll() is None,
        )
        if ready:
            state["phase"] = "ready"
            _atomic_write_json(STATE_FILE, state)
            console.print()
            ok(f"MLX server is UP and HEALTHY 🟢  →  {_local_url(host, port, '')}")
            return True
    except BaseException:
        _terminate_owned(state, proc)
        raise
    reason = "exited during startup" if proc.poll() is not None else f"was not ready within {timeout}s"
    err(f"Server {reason}; stopping it. Last log lines:")
    _tail(LOG_FILE, 20)
    _terminate_owned(state, proc)
    return False

def cmd_up(args) -> bool:
    requested_model = resolve_model(args)
    if not _network_bind_allowed(args):
        return False
    try:
        with _file_lock(CONTROL_LOCK_FILE, blocking=False):
            state = _read_server_state()
            model = (state["model"] if not _model_requested(args) and _state_is_owned(state)
                     else requested_model)
            # Preserve a healthy non-default server on bare `up` without
            # prompting for or requiring the implicit default model.
            if (state and _state_is_owned(state) and not _model_requested(args)
                    and state["host"] == args.host and state["port"] == args.port
                    and is_healthy(state["host"], state["port"])):
                return _start_locked(args, model)
            require_backend(model)
            if not confirm_download(model, args.yes):
                warn("Not starting server.")
                return False
            return _start_locked(args, model)
    except RuntimeError as exc:
        err(str(exc))
        return False

def cmd_down(args) -> None:
    try:
        with _file_lock(CONTROL_LOCK_FILE, blocking=False):
            _stop_locked()
    except RuntimeError as exc:
        err(str(exc))

def cmd_restart(args) -> None:
    requested_model = resolve_model(args)
    if not _network_bind_allowed(args):
        return
    try:
        with _file_lock(CONTROL_LOCK_FILE, blocking=False):
            state = _read_server_state()
            model = (state["model"] if not _model_requested(args) and _state_is_owned(state)
                     else requested_model)
            require_backend(model)
            if not confirm_download(model, args.yes):
                return
            _start_locked(args, model, force_restart=True)
    except RuntimeError as exc:
        err(str(exc))

def cmd_use(args) -> None:
    """Switch the served model AND pi's default together — the one command that
    keeps the two in sync. Downloads the model if needed, restarts the server on
    it, then points pi's default at that same model (only it, if pinned)."""
    model = resolve_target_model(args)   # positional REPO_ID wins, else flags
    require_backend(model)
    args.model = model                   # lock subsequent resolve_model() to it
    if getattr(args, "pin", False):
        os.environ["MLX_PIN_MODEL"] = "1"

    # 1. Make sure it's downloaded (same confirm + fetch path as `models pull`).
    if model_status(model) != "complete":
        if not confirm_download(model, args.yes):
            warn("Cancelled — model not downloaded.")
            return
        _hf_download(model)
        if model_status(model) != "complete":
            warn("Download ended but the model looks incomplete — "
                 "re-run 'mlx-pi models pull' to retry.")
            return

    # 2. Restart the server on this model.
    step(f"Switching the served model to {model}")
    if not _network_bind_allowed(args):
        return
    try:
        with _file_lock(CONTROL_LOCK_FILE, blocking=False):
            if not _start_locked(args, model, force_restart=True):
                return
    except RuntimeError as exc:
        err(str(exc))
        return

    # 3. Point pi's default at the same model (pinned → only it).
    n = align_pi_default(model, args.port)
    if n is not None:
        tag = "  [dim](pinned)[/]" if _pin_enabled() else ""
        ok(f"Server and pi are now both on [bold]{model}[/] — pi sees {n} model(s).{tag}")
    info("Open /model inside pi to pick up the change.")

def cmd_status(args) -> None:
    requested_host, requested_port = args.host, args.port
    t = Table(show_header=False, box=None, pad_edge=False)
    t.add_column(style="bold cyan")
    t.add_column()
    state = _read_server_state()
    owned = _state_is_owned(state)
    pid = state.get("pid") if owned else None
    host = state["host"] if owned else requested_host
    port = state["port"] if owned else requested_port
    healthy = is_healthy(host, port) if owned else is_healthy(requested_host, requested_port)
    t.add_row("endpoint", _local_url(host, port, ""))
    t.add_row("process", f"[green]running[/] (PID {pid})" if pid else "[red]not running[/]")
    t.add_row("health", "[green]healthy 🟢[/]" if healthy else "[red]not responding 🔴[/]")
    served = served_model(pid) if pid else None
    if served:
        t.add_row("model (preloaded)", served)
    backend = server_backend(pid) if pid else None
    if backend:
        label = "vision · mlx_vlm.server (images ✅)" if backend == "vlm" \
            else "text · mlx_lm.server (text only)"
        t.add_row("backend", label)
    pi_default = configured_model_id()
    if pi_default:
        t.add_row("pi global default", pi_default)
    if _pin_enabled():
        t.add_row("pin mode", "[green]on[/] — pi sees only the served model")
    t.add_row("log", str(LOG_FILE))
    console.print("[bold]MLX server status[/]")
    console.print(t)
    # Surface the ambiguity when process-state and the port disagree.
    if healthy and not pid:
        warn(f"Something is answering on port {port}, but mlx-pi isn't tracking "
             "a server it started — another process may be using this port.")
    elif state and not owned:
        warn("The saved server identity is stale; mlx-pi will not signal that PID.")
    elif pid and not healthy:
        info("Process is up but not answering yet — likely still loading/downloading "
             "the model (watch './mlx-pi logs').")
    # Sync check: same-backend choices can reload on demand. The state records
    # the launch model; status intentionally uses cheap liveness rather than a
    # generation probe or treating a legitimate VLM hot-swap as unhealthy.
    if served and pi_default and served != pi_default:
        if backend_kind(served) != backend_kind(pi_default):
            warn(f"pi's global default [bold]{pi_default}[/] uses a different backend "
                 f"from the active [bold]{served}[/] server. They cannot hot-swap; "
                 f"align them with [bold]mlx-pi use {pi_default}[/] or "
                 f"[bold]mlx-pi pi --model {served}[/].")
        else:
            warn(f"pi defaults to [bold]{pi_default}[/], but the server preloaded "
                 f"[bold]{served}[/]. pi's first request will reload it "
                 f"(slower, more RAM). Align both with [bold]mlx-pi use {pi_default}[/], "
                 f"or pick the served model inside pi.")
    elif served and len(configured_model_ids()) > 1:
        console.print("  [dim]Note: pi can pick any registered model; the server "
                      "hot-swaps per request, so choosing a non-preloaded model "
                      "reloads it on first use.[/]")

def cmd_logs(args) -> None:
    if not LOG_FILE.exists():
        warn(f"No log yet at {LOG_FILE}")
        return
    info(f"Tailing {LOG_FILE} (Ctrl-C to stop; server keeps running)…")
    # Hand off to `tail -f` for a proper follow.
    os.execvp("tail", ["tail", "-n", "50", "-f", str(LOG_FILE)])

def cmd_run(args) -> None:
    """Foreground server (blocks). Good for debugging."""
    model = resolve_model(args)
    require_backend(model)
    if not _network_bind_allowed(args):
        return
    if not confirm_download(model, args.yes):
        warn("Not starting server.")
        return
    kind = "vision (mlx_vlm.server)" if is_vision_model(model) else "text (mlx_lm.server)"
    info(f"Running MLX server in the FOREGROUND (Ctrl-C to stop): {model} — {kind}")
    bin_path = server_bin(model)
    os.execvp(bin_path, [bin_path, "--model", model,
              "--host", args.host, "--port", str(args.port),
              "--max-tokens", str(DEFAULT_MAX_TOKENS)])

def cmd_pi(args) -> None:
    if not have("pi"):
        err("pi not found. Run './mlx-pi setup' first.")
        sys.exit(1)
    # Ordering guarantee: bring the engine up (idempotent) BEFORE pi starts.
    if not cmd_up(args):
        return
    # An explicit model always becomes pi's default. On a bare invocation, also
    # repair a cross-backend default: that mismatch cannot hot-swap safely.
    if _model_requested(args):
        model = resolve_model(args)
        if configured_model_id() != model:
            align_pi_default(model, args.port)
            info(f"pi will open on [bold]{model}[/].")
    else:
        state = _read_server_state()
        pi_default = configured_model_id()
        if (_state_is_owned(state)
                and (not pi_default or backend_kind(pi_default) != state["backend"])):
            align_pi_default(state["model"], state["port"])
            info(f"Aligned pi with the active {state['backend']} backend: "
                 f"[bold]{state['model']}[/].")
    console.print()
    info("Launching pi. Inside pi: [bold]/model[/] → switch between your "
         "[bold]local-mlx[/] models.")
    info("Leaving pi (/exit) keeps the server running.")
    console.print()
    os.execvp("pi", ["pi"])


