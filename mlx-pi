def _positive_env_int(name: str, default: int) -> int:
    """Read a positive integer environment setting with an actionable error."""
    raw = os.environ.get(name)
    if raw is None:
        return default
    try:
        value = int(raw)
    except ValueError:
        err(f"{name} must be a positive integer; got {raw!r}.")
        raise SystemExit(2)
    if value <= 0:
        err(f"{name} must be greater than zero; got {value}.")
        raise SystemExit(2)
    return value


def _atomic_write(path: Path, content: str | bytes, mode: int = 0o600) -> None:
    """Atomically replace a file so interruption never leaves partial state."""
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        binary = isinstance(content, bytes)
        with os.fdopen(fd, "wb" if binary else "w") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_name, path)
        os.chmod(path, mode)
        try:
            dfd = os.open(path.parent, os.O_RDONLY)
            try:
                os.fsync(dfd)
            finally:
                os.close(dfd)
        except OSError:
            pass
    except BaseException:
        try:
            os.close(fd)
        except OSError:
            pass
        Path(tmp_name).unlink(missing_ok=True)
        raise


def _atomic_write_json(path: Path, data: dict) -> None:
    _atomic_write(path, json.dumps(data, indent=2) + "\n")


@contextlib.contextmanager
def _file_lock(path: Path, *, blocking: bool = True):
    """Advisory lock shared by cooperating mlx-pi processes."""
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(path, "a+") as f:
        os.chmod(path, 0o600)
        flags = fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB)
        try:
            fcntl.flock(f.fileno(), flags)
        except BlockingIOError:
            raise RuntimeError("another mlx-pi operation is already in progress")
        try:
            yield
        finally:
            fcntl.flock(f.fileno(), fcntl.LOCK_UN)

def _hf_cache_dir() -> Path:
    """Resolve the HF hub cache the same way huggingface_hub does, so we look
    where models are actually stored when HF_HOME / HF_HUB_CACHE are customized."""
    if os.environ.get("HF_HUB_CACHE"):
        return Path(os.environ["HF_HUB_CACHE"])
    if os.environ.get("HF_HOME"):
        return Path(os.environ["HF_HOME"]) / "hub"
    base = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    return base / "huggingface" / "hub"

HF_CACHE = _hf_cache_dir()


